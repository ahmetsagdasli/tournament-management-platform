{
  "name": "tournament-platform-backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test jest --runInBand",
    "migrate": "node -r dotenv/config ./node_modules/node-pg-migrate/bin/node-pg-migrate.js --migrations-dir migrations --migration-file-language sql",
    "seed:admin": "tsx src/scripts/seedAdmin.ts",
    "seed:demo": "tsx src/scripts/seedDemo.ts"
  },
  "dependencies": {
    "bcrypt": "5",
    "cors": "2",
    "dotenv": "16",
    "express": "4",
    "helmet": "7",
    "jsonwebtoken": "9",
    "pg": "8",
    "zod": "3"
  },
  "devDependencies": {
    "@types/bcrypt": "5",
    "@types/cors": "2",
    "@types/express": "4",
    "@types/jest": "29",
    "@types/jsonwebtoken": "9",
    "@types/node": "20",
    "@types/pg": "8",
    "@types/supertest": "6",
    "jest": "29",
    "node-pg-migrate": "7",
    "supertest": "7",
    "ts-jest": "29",
    "tsx": "4",
    "typescript": "5"
  }
}
